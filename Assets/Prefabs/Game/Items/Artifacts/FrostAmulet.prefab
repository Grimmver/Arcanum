  m_Name: 
  m_EditorClassIdentifier: 
  itemName:
    languages:
    - Language: EN
      Text: Winter Amulet
    - Language: RU
      Text: "\u0417\u0438\u043C\u043D\u0438\u0439 \u0410\u043C\u0443\u043B\u0435\u0442"
  cost: 1000
  description:
    languages:
    - Language: EN
      Text: Increases ice damage. Increases ice but reduces fire elements spawn rates.
        Increases damage to frozen enemies. +100 max health.
    - Language: RU
      Text: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
        \u043E\u0442 \u043B\u044C\u0434\u0430. \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
        \u043B\u0435\u0434, \u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442
        \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F
        \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u043E\u0433\u043D\u044F.
        \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
        \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u043C
        \u0432\u0440\u0430\u0433\u0430\u043C. +100 \u043A \u043C\u0430\u043A\u0441.
        \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E."
  rarity: 2
