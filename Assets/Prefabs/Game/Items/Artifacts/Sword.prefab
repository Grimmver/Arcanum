--- !u!114 &5363327197973580643
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8534377222556850228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0c2ed4307d5714eba9598b746dbc3d5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemName:
    languages:
    - Language: EN
      Text: Sword
    - Language: RU
      Text: "\u041C\u0435\u0447"
  cost: 300
  description:
    languages:
    - Language: EN
      Text: Decreases player's magical abilities and adds sword tiles to the pool.
        Swords deal good physical damage. Additionally, swords apply retaliation
        status effect stack to the player, dealing extra damage upon being hurt.
    - Language: RU
      Text: "\u041F\u043E\u043D\u0438\u0436\u0430\u0435\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0438\u0433\u0440\u043E\u043A\u0430
        \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u0435\u0447\u0438
        \u0432 \u043F\u0443\u043B \u0442\u0430\u0439\u043B\u043E\u0432. \u041C\u0435\u0447\u0438
        \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
        \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D.
        \u0422\u0430\u043A\u0436\u0435 \u043C\u0435\u0447\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442
        \u044D\u0444\u0444\u0435\u043A\u0442 \u043E\u0442\u0432\u0435\u0442\u043D\u043E\u0433\u043E
        \u0443\u0434\u0430\u0440\u0430 \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430,
        \u043D\u0430\u043D\u043E\u0441\u044F \u0434\u043E\u043F. \u0443\u0440\u043E\u043D
        \u043F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438
        \u0443\u0440\u043E\u043D\u0430."
  rarity: 0
