--- !u!114 &1155395846366574161
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7987081044804423537}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89f2e9baccea87a41b8995aec95ce061, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemName:
    languages:
    - Language: EN
      Text: Stone Armor
    - Language: RU
      Text: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0411\u0440\u043E\u043D\u044F"
  cost: 1700
  description:
    languages:
    - Language: EN
      Text: Adds stone element but removes shield element. Matching stone elements
        does the same as shield but also grants +1 Armor per combo count and removes
        random negative effect from player. Reduces the amount of lightning tiles.
        Increases player's physical defence.
    - Language: RU
      Text: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u044D\u043B\u0435\u043C\u0435\u043D\u0442
        \u043A\u0430\u043C\u043D\u044F, \u043D\u043E \u0443\u0431\u0438\u0440\u0430\u0435\u0442
        \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0449\u0438\u0442\u0430. \u042D\u043B\u0435\u043C\u0435\u043D\u0442
        \u043A\u0430\u043C\u043D\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
        \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u0449\u0438\u0442,
        \u043D\u043E \u0442\u0430\u043A\u0436\u0435 \u0434\u0430\u0451\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        +1 \u043A \u0431\u0440\u043E\u043D\u0435 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
        \u043A\u043E\u043C\u0431\u043E \u0438 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
        \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0439
        \u044D\u0444\u0444\u0435\u043A\u0442 \u0441 \u0438\u0433\u0440\u043E\u043A\u0430.
        \u0423\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u043F\u043B\u0438\u0442\u043E\u043A \u043C\u043E\u043B\u043D\u0438\u0439.
        \u041F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
        \u0438\u0433\u0440\u043E\u043A\u0430.\r"
  rarity: 2
  incompatibleItems: []
