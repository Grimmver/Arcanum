  itemName:
    languages:
    - Language: EN
      Text: Chaos Crystal
    - Language: RU
      Text: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B \u0425\u0430\u043E\u0441\u0430"
  cost: 450
  description:
    languages:
    - Language: EN
      Text: At the start of battle and each turn, turns a random colour, boosting
        respective primary damage (Fire, ice or lightning) by 50%.
    - Language: RU
      Text: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0431\u0438\u0442\u0432\u044B
        \u0438 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0445\u043E\u0434\u0430,
        \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0446\u0432\u0435\u0442,
        \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044F \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
        \u0443\u0440\u043E\u043D (\u041E\u0433\u043E\u043D\u044C, \u043B\u0451\u0434
        \u0438\u043B\u0438 \u043C\u043E\u043B\u043D\u0438\u044F) \u043D\u0430 50%."
