  m_Name: 
  m_EditorClassIdentifier: 
  localizedEntries:
  - Language: EN
    Text: Inventory has 12 slots, where you can put your bought items. If you forgot
      their effects, you can tap on the items.
  - Language: RU
    Text: "\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      12 \u044F\u0447\u0435\u0435\u043A, \u043A\u0443\u0434\u0430 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u043C\u0435\u0449\u0430\u0442\u044C \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0451\u043D\u043D\u044B\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B. \u0415\u0441\u043B\u0438
      \u0432\u044B \u0437\u0430\u0431\u044B\u043B\u0438 \u0438\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u044B,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
