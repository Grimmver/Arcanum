--- !u!114 &7039656776438176234
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5987381508799435328}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1099aa0f431488c45b5d9deccf04e73b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localizedEntries:
  - Language: EN
    Text: "Matching ice elements launches an ice shard, dealing medium damage and
      applying ice status effect stacks. At high stacks, the enemy is frozen and
      can\u2019t attack. The more resilient the enemy is, the more stacks are needed.
      The more ice/frozen stacks the enemy has, the more damage they take from ice
      attacks."
  - Language: RU
    Text: "\u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u043B\u0435\u0434\u044F\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043B\u0435\u0434\u044F\u043D\u0443\u044E
      \u0433\u043B\u044B\u0431\u0443, \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0443\u044E
      \u0441\u0440\u0435\u0434\u043D\u0438\u0439 \u0443\u0440\u043E\u043D \u0438
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0449\u0443\u044E
      \u044D\u0444\u0444\u0435\u043A\u0442 \u043B\u044C\u0434\u0430. \u041F\u0440\u0438
      \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u0447\u0438\u0441\u043B\u0430 \u0441\u0442\u0430\u043A\u043E\u0432 \u0432\u0440\u0430\u0433
      \u0437\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C.
      \u0427\u0435\u043C \u0436\u0438\u0432\u0443\u0447\u0435\u0435 \u0432\u0440\u0430\u0433,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0442\u0430\u043A\u043E\u0432
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u043B\u044F
      \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0438. \u0427\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0442\u0430\u043A\u043E\u0432 \u043B\u044C\u0434\u0430/\u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0438
      \u0443 \u0432\u0440\u0430\u0433\u0430, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u0443\u0440\u043E\u043D\u0430 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u043E\u0442 \u043B\u0435\u0434\u044F\u043D\u044B\u0445 \u0430\u0442\u0430\u043A."
