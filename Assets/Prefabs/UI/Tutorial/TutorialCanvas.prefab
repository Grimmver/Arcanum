    - target: {fileID: 3515036799870229043, guid: a0f0afc9320d29b478c8fb88bae5c6d3, type: 3}
      propertyPath: m_text
      value: "\u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
        \u0432\u044B\u0437\u043E\u0432\u0435\u0442 \u041E\u0413\u041D\u0415\u041D\u041D\u042B\u0419
        \u0428\u0410\u0420!!! \u041E\u043D \u043D\u0430\u043D\u043E\u0441\u0438\u0442
        \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0440\u043E\u043D \u0438
        \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
        \u0433\u043E\u0440\u0435\u043D\u0438\u044F. \u042D\u0444\u0444\u0435\u043A\u0442\u044B
        \u0433\u043E\u0440\u0435\u043D\u0438\u044F \u043D\u0430\u043D\u043E\u0441\u044F\u0442
        \u0443\u0440\u043E\u043D \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434,
        \u043D\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
        \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0430\u044E\u0442."
      objectReference: {fileID: 0}
