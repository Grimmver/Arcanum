  m_Script: {fileID: 11500000, guid: 1099aa0f431488c45b5d9deccf04e73b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localizedEntries:
  - Language: EN
    Text: Each wave gets tougher as you descend the dungeon, but crystals earned
      also increase. Strong enemies with unique abilities appear on lower floors.
      Most enemies have resistances and/or weaknesses to certain types of damage.
  - Language: RU
    Text: "\u0421 \u043A\u0430\u0436\u0434\u043E\u0439 \u0432\u043E\u043B\u043D\u043E\u0439
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0432\u0441\u0451 \u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u043D\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0445
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432 \u0442\u043E\u0436\u0435
      \u0440\u0430\u0441\u0442\u0451\u0442. \u041D\u0430 \u043D\u0438\u0436\u043D\u0438\u0445
      \u044D\u0442\u0430\u0436\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0432\u0440\u0430\u0433\u0438 \u0441
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0432\u0440\u0430\u0433\u043E\u0432
      \u0438\u043C\u0435\u044E\u0442 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F
      \u0438/\u0438\u043B\u0438 \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0438
      \u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C
      \u0442\u0438\u043F\u0430\u043C \u0443\u0440\u043E\u043D\u0430."
