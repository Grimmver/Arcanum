    - target: {fileID: 3515036799870229043, guid: a0f0afc9320d29b478c8fb88bae5c6d3, type: 3}
      propertyPath: m_text
      value: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
        \u0420\u0435\u0434\u043A\u043E\u0441\u0442\u044C\u044E, \u0426\u0435\u043D\u043E\u0439,
        \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438
        \u0438 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
        \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C\u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438.
        \u0418\u043D\u043E\u0433\u0434\u0430 \u0438\u0445 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
        \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0438\u043C\u0435\u0435\u0442
        \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435...\n\u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u0443\u0439\u0442\u0435
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u0447\u0442\u043E\u0431\u044B
        \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0443\u044E
        \u0441\u0431\u043E\u0440\u043A\u0443 \u0410\u0420\u041A\u0410\u041D\u0423\u041C\u0410."
      objectReference: {fileID: 0}
