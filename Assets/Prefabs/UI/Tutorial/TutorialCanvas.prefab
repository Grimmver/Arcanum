--- !u!114 &219054458248097009
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7014088440190631612}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1099aa0f431488c45b5d9deccf04e73b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localizedEntries:
  - Language: EN
    Text: 'These are the basic elements, each having unique mechanics when matched.
      The more elements you match in one move, the stronger your spell becomes. '
  - Language: RU
    Text: "\u042D\u0442\u043E \u0431\u0430\u0437\u043E\u0432\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439
      \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u043E\u0439 \u043F\u0440\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438.
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
      \u0442\u044B \u0441\u043A\u043E\u043C\u0431\u0435\u043D\u0438\u0440\u0443\u0435\u0448\u044C
      \u0437\u0430 \u043E\u0434\u0438\u043D \u0445\u043E\u0434, \u0442\u0435\u043C
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0442\u0432\u043E\u0451 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435."
