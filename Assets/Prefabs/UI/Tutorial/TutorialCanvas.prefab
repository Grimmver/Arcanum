    - target: {fileID: 3515036799870229043, guid: a0f0afc9320d29b478c8fb88bae5c6d3, type: 3}
      propertyPath: m_text
      value: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u043A\u0430\u0436\u0434\u044B\u0435 5 \u0432\u043E\u043B\u043D \u2014 \u043F\u043E\u043A\u0443\u043F\u0430\u0439\u0442\u0435
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u043B\u0435\u0447\u0438\u0442\u0435\u0441\u044C
        \u0438\u043B\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0439\u0442\u0435
        \u0430\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442, \u0435\u0441\u043B\u0438
        \u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
        \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B, \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
        \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
        \u0432\u043E\u043B\u043D."
